{
  "defaults": {
    "standard": "WCAG2AA",
    "runners": [
      "axe",
      "htmlcs"
    ],
    "levelCapWhenNeedsReview": "warning",
    "timeout": 30000,
    "wait": 500,
    "chromeLaunchConfig": {
      "args": [
        "--no-sandbox",
        "--disable-dev-shm-usage"
      ]
    },
    "ignore": [
      "warning",
      "notice"
    ]
  },
  "urls": [
    "http://localhost:3000/"
  ]
}
